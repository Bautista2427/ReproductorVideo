<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.reproductorvideo.reproductorvideoapp.ReproductorVideoController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <SplitPane dividerPositions="0.5" orientation="VERTICAL" prefHeight="400.0" prefWidth="600.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="160.0">
                    <children>
                        <Label layoutX="79.0" layoutY="48.0" prefHeight="18.0" prefWidth="98.0" text="Archivo del video" />
                        <TextField fx:id="txtArchivoVideo" layoutX="206.0" layoutY="45.0" />
                        <Button fx:id="btnReproducirVideo" layoutX="243.0" layoutY="98.0" mnemonicParsing="false" onAction="#onReproducirVideo" text="Reproducir" />
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="160.0">
                    <children>
                        <TextArea fx:id="txtSalida" layoutX="8.0" layoutY="9.0" prefHeight="178.0" prefWidth="582.0" />
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
